{
  "name": "taco-brain",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "TacoBrain: punto de venta, captura de tickets por foto y reportes por voz para taquerías",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/bricolage-grotesque": "^5.2.0",
    "@fontsource/ibm-plex-sans": "^5.2.0",
    "@supabase/supabase-js": "^2.100.0",
    "react": "^19.1.9",
    "react-dom": "^19.1.9"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "~5.9.3",
    "vite": "^6.4.4",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^3.2.7"
  }
}
