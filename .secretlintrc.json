{
  "rules": [
    { "id": "@secretlint/secretlint-rule-preset-recommend" },
    {
      "id": "@secretlint/secretlint-rule-pattern",
      "options": {
        "patterns": [
          { "name": "Llave de Anthropic (Claude)", "pattern": "/sk-ant-[A-Za-z0-9_-]{20,}/" },
          { "name": "Llave de OpenAI", "pattern": "/sk-(proj-|svcacct-|admin-)?[A-Za-z0-9_-]{20,}/" },
          { "name": "Llave secreta de Supabase", "pattern": "/sb_secret_[A-Za-z0-9_-]{10,}/" },
          { "name": "Token JWT (anon o service_role de Supabase)", "pattern": "/eyJ[A-Za-z0-9_-]{10,}\\.eyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}/" },
          { "name": "Contraseña en URL de base de datos", "pattern": "/postgres(ql)?:\\/\\/[^:\\s]+:[^@\\s]+@/" }
        ]
      }
    }
  ]
}
